{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Generated project idea with reality check and blueprint",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "concept": { "type": "string" },
        "problemStatement": { "type": "string" },
        "targetUsers": { "type": "string" },
        "proposedSolution": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "innovation": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": "string" },
        "duration": { "type": "string" },
        "cost": { "type": "string" },
        "aiOpps": { "type": "string" },
        "outcome": { "type": "string" },
        "challenges": { "type": "string" },
        "realityCheck": {
          "type": "object",
          "properties": {
            "feasibilityScore": { "type": "number" },
            "innovationScore": { "type": "number" },
            "complexityScore": { "type": "number" },
            "costScore": { "type": "number" },
            "timeSuitability": { "type": "number" },
            "skillMatchScore": { "type": "number" },
            "explanation": { "type": "string" },
            "risks": { "type": "array", "items": { "type": "string" } },
            "recommendations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "blueprint": {
          "type": "object",
          "properties": {
             "overview": { "type": "string" },
             "roadmap": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "MentorMessage": {
      "title": "MentorMessage",
      "description": "Message in the mentor chat for a project",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["role", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects generated by users"
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MentorMessage" },
      "description": "Chat messages for mentor mode"
    }
  }
}
